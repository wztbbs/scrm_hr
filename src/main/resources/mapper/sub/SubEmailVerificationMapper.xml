<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scrm.dao.sub.SubEmailVerificationMapper">

  <select id="selectLatestByEmail" resultMap="com.scrm.dao.EmailVerificationMapper.BaseResultMap">
    select
    <include refid="com.scrm.dao.EmailVerificationMapper.Base_Column_List"/>
    from email_verifications
    where email = #{email,jdbcType=VARCHAR}
    order by created_at desc
    limit 1
  </select>

  <update id="updateStatusByEmail">
    update email_verifications
    set status = #{status,jdbcType=VARCHAR}
    where email = #{email,jdbcType=VARCHAR}
  </update>

  <delete id="deleteByEmail">
    delete from email_verifications
    where email = #{email,jdbcType=VARCHAR}
  </delete>

</mapper>
