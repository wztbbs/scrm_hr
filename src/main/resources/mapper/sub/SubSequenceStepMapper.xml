<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scrm.dao.sub.SubSequenceStepMapper">

  <select id="countUpdatedSince" resultType="java.lang.Long">
    select count(*) from sequence_steps
    where updated_at &gt;= #{since} and user_id = #{userId}
  </select>

  <select id="selectUpdatedSince" resultMap="com.scrm.dao.SequenceStepMapper.ResultMapWithBLOBs">
    select
    <include refid="com.scrm.dao.SequenceStepMapper.Base_Column_List"/>
    ,
    <include refid="com.scrm.dao.SequenceStepMapper.Blob_Column_List"/>
    from sequence_steps
    where updated_at &gt;= #{since} and user_id = #{userId}
    order by updated_at ASC
  </select>

</mapper>
