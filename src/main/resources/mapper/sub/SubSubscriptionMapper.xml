<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scrm.dao.sub.SubSubscriptionMapper">

  <select id="selectByPaddleSubscriptionId" parameterType="java.lang.String" resultMap="com.scrm.dao.SubscriptionMapper.BaseResultMap">
    select
    <include refid="com.scrm.dao.SubscriptionMapper.Base_Column_List" />
    from subscriptions
    where paddle_subscription_id = #{paddleSubscriptionId,jdbcType=VARCHAR}
    limit 1
  </select>

  <select id="selectActiveByUserId" parameterType="java.lang.Long" resultMap="com.scrm.dao.SubscriptionMapper.BaseResultMap">
    select
    <include refid="com.scrm.dao.SubscriptionMapper.Base_Column_List" />
    from subscriptions
    where user_id = #{userId,jdbcType=BIGINT}
      and status = 'active'
    order by id desc
    limit 1
  </select>

</mapper>
