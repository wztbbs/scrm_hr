<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scrm.dao.CandidateExtMapper">
  <resultMap id="BaseResultMap" type="com.scrm.entity.Candidate">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="user_id" jdbcType="BIGINT" property="userId" />
    <result column="full_name" jdbcType="VARCHAR" property="fullName" />
    <result column="headline" jdbcType="VARCHAR" property="headline" />
    <result column="job_title" jdbcType="VARCHAR" property="jobTitle" />
    <result column="company" jdbcType="VARCHAR" property="company" />
    <result column="location" jdbcType="VARCHAR" property="location" />
    <result column="linkedin_url" jdbcType="VARCHAR" property="linkedinUrl" />
    <result column="linkedin_id" jdbcType="VARCHAR" property="linkedinId" />
    <result column="email" jdbcType="VARCHAR" property="email" />
    <result column="phone" jdbcType="VARCHAR" property="phone" />
    <result column="avatar_url" jdbcType="VARCHAR" property="avatarUrl" />
    <result column="connection_degree" jdbcType="CHAR" property="connectionDegree" />
    <result column="temperature" jdbcType="CHAR" property="temperature" />
    <result column="is_ai_suggested_temp" jdbcType="BIT" property="isAiSuggestedTemp" />

    <result column="source" jdbcType="CHAR" property="source" />
    <result column="last_activity_at" jdbcType="TIMESTAMP" property="lastActivityAt" />
    <result column="created_at" jdbcType="TIMESTAMP" property="createdAt" />
    <result column="updated_at" jdbcType="TIMESTAMP" property="updatedAt" />
  </resultMap>

  <select id="searchByKeyword" resultMap="BaseResultMap">
    SELECT * FROM candidates
    WHERE user_id = #{userId}
    <if test="search != null and search != ''">
      AND (full_name LIKE CONCAT('%', #{search}, '%')
        OR company LIKE CONCAT('%', #{search}, '%')
        OR job_title LIKE CONCAT('%', #{search}, '%'))
    </if>
    <if test="temperature != null and temperature != ''">
      AND temperature = #{temperature}
    </if>

    <if test="source != null and source != ''">
      AND source = #{source}
    </if>
    <if test="syncSince != null">
      AND updated_at &gt;= #{syncSince}
    </if>
    ORDER BY
    <choose>
      <when test="sortBy == 'last_activity_at'">last_activity_at</when>
      <when test="sortBy == 'full_name'">full_name</when>
      <otherwise>created_at</otherwise>
    </choose>
    <choose>
      <when test="sortOrder == 'asc'">ASC</when>
      <otherwise>DESC</otherwise>
    </choose>
    LIMIT #{pageSize} OFFSET #{offset}
  </select>

  <select id="countSearchByKeyword" resultType="long">
    SELECT COUNT(*) FROM candidates
    WHERE user_id = #{userId}
    <if test="search != null and search != ''">
      AND (full_name LIKE CONCAT('%', #{search}, '%')
        OR company LIKE CONCAT('%', #{search}, '%')
        OR job_title LIKE CONCAT('%', #{search}, '%'))
    </if>
    <if test="temperature != null and temperature != ''">
      AND temperature = #{temperature}
    </if>

    <if test="source != null and source != ''">
      AND source = #{source}
    </if>
    <if test="syncSince != null">
      AND updated_at &gt;= #{syncSince}
    </if>
  </select>
</mapper>
